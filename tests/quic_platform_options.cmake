# Verify option policy only; this does not emulate a platform toolchain.
cmake_minimum_required(VERSION 3.15)

set(CMAKE_SYSTEM_NAME "${NNG_TEST_SYSTEM}")
set(WIN32 OFF)
set(APPLE OFF)
if (NNG_TEST_SYSTEM STREQUAL "Windows")
    set(WIN32 ON)
elseif (NNG_TEST_SYSTEM STREQUAL "Darwin")
    set(APPLE ON)
endif ()

# Seed stale layer flags as well as the user's top-level request.
set(NNG_ENABLE_QUIC ${NNG_TEST_QUIC} CACHE BOOL "" FORCE)
set(NNG_PROTO_MQTT_QUIC_CLIENT ON CACHE BOOL "" FORCE)
set(NNG_TRANSPORT_MQTT_QUIC ON CACHE BOOL "" FORCE)
set(NNG_SUPP_QUIC ON)
include("${NNG_SOURCE_DIR}/cmake/NNGOptions.cmake")

set(_expected_quic ${NNG_TEST_QUIC})
set(_expected_zstd ON)
if (WIN32 OR APPLE)
    set(_expected_quic OFF)
    set(_expected_zstd OFF)
endif ()
foreach (_flag NNG_ENABLE_QUIC NNG_PROTO_MQTT_QUIC_CLIENT
        NNG_TRANSPORT_MQTT_QUIC NNG_SUPP_QUIC)
    if (NOT "${${_flag}}" STREQUAL "${_expected_quic}")
        message(FATAL_ERROR "${_flag}=${${_flag}}, expected ${_expected_quic}")
    endif ()
endforeach ()
if (NOT "${NNG_ENABLE_ZSTD}" STREQUAL "${_expected_zstd}")
    message(FATAL_ERROR "Unexpected zstd default: ${NNG_ENABLE_ZSTD}")
endif ()
if (_expected_quic)
    if (NOT NNG_QUIC_LIB STREQUAL "msquic")
        message(FATAL_ERROR "Enabled QUIC lost its MsQuic backend")
    endif ()
elseif (NOT NNG_QUIC_LIB STREQUAL "none")
    message(FATAL_ERROR "Disabled QUIC retained a backend")
endif ()
